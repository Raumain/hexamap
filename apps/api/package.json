{
  "name": "@hexamap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./auth": "./src/auth.ts",
    "./type": "./src/type.ts",
    "./lib/*": "./src/lib/*.ts",
    "./services/*": "./src/services/*.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "auth:generate": "bunx auth@latest generate --adapter kysely",
    "vapid:generate": "bun src/scripts/vapid.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/openapi": "^1.4.17",
    "@hexamap/db": "workspace:*",
    "@hexamap/shared": "workspace:*",
    "better-auth": "^1.7.25",
    "elysia": "^1.4.32",
    "kysely": "^0.29.9",
    "stripe": "^18.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "kysely-codegen": "^0.20.0"
  }
}
