# Identifiants hôte utilisés par les conteneurs de développement
UID=1000
GID=1000

# PostgreSQL
POSTGRES_USER=hexamap
POSTGRES_PASSWORD=hexamap
POSTGRES_DB=hexamap
DATABASE_URL=postgres://hexamap:hexamap@db:5432/hexamap
# Publication du port PostgreSQL sur la machine hôte pour les outils de
# vérification (DBeaver, psql). 127.0.0.1 = boucle locale uniquement, jamais
# le LAN ; ::1 est toujours publié en plus pour que `localhost` fonctionne.
# Mettre POSTGRES_BIND=0.0.0.0 pour exposer sur le réseau (déconseillé).
POSTGRES_BIND=127.0.0.1
POSTGRES_HOST_PORT=5432

# Base de test dédiée au gatekeeper (jamais la base de développement).
# `bun run ci:check` refuse de s'exécuter si TEST_DATABASE_URL est absente ou
# identique à DATABASE_URL. L'hôte `db` est celui du réseau Docker : toutes les
# commandes passent par le conteneur `dev`.
TEST_DATABASE_URL=postgres://hexamap:hexamap@db:5432/hexamap_test

# pgAdmin (profil « admin ») : docker compose --profile admin up -d pgadmin
PGADMIN_DEFAULT_EMAIL=admin@hexamap.dev
PGADMIN_DEFAULT_PASSWORD=hexamap
PGADMIN_HOST_PORT=5050

# API
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5174
BETTER_AUTH_URL=http://localhost:3000
# Secret de signature des sessions (32 caractères minimum). Cette valeur
# d'exemple est refusée par le schéma : générez la vôtre avec
# `openssl rand -base64 48`, une par environnement.
BETTER_AUTH_SECRET=change-me
# Origine publique du frontend : seule origine autorisée par CORS et par Better
# Auth en production. En développement : http://localhost:5174.
# En production derrière Nginx : https://hexamap.example.com
FRONTEND_URL=http://localhost:5174
# Cookies `Secure` : forcés dès que NODE_ENV=production. Ne passer à `false`
# que pour un banc de test servi en HTTP simple (jamais en production réelle).
# AUTH_COOKIE_SECURE=false
# Origines supplémentaires autorisées (CORS + Better Auth), séparées par des virgules.
# Ex. : TRUSTED_ORIGINS=http://192.168.1.30:5174,https://hexamap.example.com
TRUSTED_ORIGINS=

# Stack de production (docker-compose.prod.yml). Le préfixe PROD_ évite de
# réutiliser les valeurs de développement ci-dessus.
# PROD_FRONTEND_URL=https://hexamap.example.com
# PROD_APP_URL=https://hexamap.example.com
# PROD_BETTER_AUTH_URL=https://hexamap.example.com
# WEB_HOST_PORT=8080
# Applique les migrations au démarrage de l'API. Passer à 0 pour un déploiement
# à deux réplicas ou un blue/green : deux conteneurs qui migrent en parallèle se
# disputent le verrou de Kysely.
# RUN_MIGRATIONS=1
# Noms des volumes de production. Les valeurs par défaut portent déjà le préfixe
# `prod` (`hexamap_prod_pgdata`, `hexamap_prod_blasons`,
# `hexamap_prod_importstatus`) : ne les surcharger que pour rattacher un volume
# existant, sinon deux environnements se partagent les mêmes données.
# PROD_PGDATA_VOLUME=hexamap_prod_pgdata
# BLASONS_VOLUME=hexamap_prod_blasons
# IMPORT_STATUS_VOLUME=hexamap_prod_importstatus

# Boutique — Stripe. Les six variables sont exigées par la stack de production
# (`:?` dans docker-compose.prod.yml) : sans elles, le conteneur refuse de
# démarrer. Les identifiants `price_…` se créent dans le Dashboard, jamais ici.
# STRIPE_SECRET_KEY=sk_live_…
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_PRICE_PACK_500=price_…
# STRIPE_PRICE_PACK_1200=price_…
# STRIPE_PRICE_PACK_2500=price_…
# STRIPE_PRICE_PACK_6000=price_…
# Consentement aux CGV au moment du paiement. Laisser éteint tant qu'aucune URL
# de CGV n'est enregistrée dans le Dashboard Stripe : `terms_of_service:
# 'required'` y est alors refusé et le checkout casse.
# SHOP_REQUIRE_TOS_CONSENT=false

# Mandataires de confiance pour la résolution de l'IP cliente (Better Auth,
# `advanced.ipAddress.trustedProxies`). Vide par défaut : sans bordure connue,
# aucun en-tête `X-Forwarded-For` n'est cru. Renseigner l'adresse ou le CIDR du
# reverse proxy d'hébergement une fois celui-ci choisi, séparés par des virgules.
# Ex. : TRUSTED_PROXIES=172.18.0.0/16,10.0.0.5
TRUSTED_PROXIES=

# Cible du proxy Vite côté serveur (résolution Docker interne). Le navigateur ne
# connaît que l'origine du web ; Vite relaye /api vers cette URL.
API_INTERNAL_URL=http://api:3000
